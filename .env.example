# Copy this file to .env and replace every CHANGE_ME value locally.
# Do not commit .env files or use any V1, production, or shared database URL.

QUOTEOPS_ENV=local
QUOTEOPS_DATABASE_URL=postgresql+psycopg://quoteops_v2:CHANGE_ME@localhost:5432/quoteops_v2
QUOTEOPS_TEST_DATABASE_URL=postgresql+psycopg://quoteops_v2_test:CHANGE_ME@localhost:5432/quoteops_v2_test
QUOTEOPS_CORS_ORIGINS=http://localhost:5173
QUOTEOPS_AUTH_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_VALUE
QUOTEOPS_DEMO_ENABLED=false
QUOTEOPS_DOCS_ENABLED=true
QUOTEOPS_OPENAPI_ENABLED=true
VITE_API_BASE_URL=http://localhost:8000
